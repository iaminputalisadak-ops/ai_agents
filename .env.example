# AI Voice Agent - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - OpenAI (for AI brain)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model: gpt-4 (recommended), gpt-3.5-turbo (faster/cheaper)
OPENAI_MODEL=gpt-4

# =============================================================================
# OPTIONAL - External APIs
# =============================================================================
# Weather: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=

# News: https://newsapi.org
NEWS_API_KEY=

# =============================================================================
# FLASK
# =============================================================================
FLASK_ENV=development
SECRET_KEY=change-this-in-production

# =============================================================================
# VOICE SETTINGS
# =============================================================================
# Words per minute (100-250)
DEFAULT_VOICE_SPEED=175

# Volume 0.0 to 1.0
DEFAULT_VOICE_VOLUME=1.0

# Conversation memory (number of exchanges to keep)
CONVERSATION_MEMORY_LIMIT=10
